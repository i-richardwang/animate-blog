# Uptime Kuma status page behind /status (optional; these are the defaults)
UPTIME_KUMA_URL=https://status.homelab.wang
UPTIME_KUMA_SLUG=homelab

# Token Usage - CCusage Database (MyCCusage)
CCUSAGE_DATABASE_URL=postgresql://user:password@host:port/dbname

# Token Usage - LLMeter Database (token-tracker)
LLMETER_DATABASE_URL=postgresql://user:password@host:port/dbname

# Umami analytics (optional; omitted means no analytics script)
NEXT_PUBLIC_UMAMI_SCRIPT=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
